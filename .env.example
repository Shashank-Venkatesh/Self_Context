# Runtime
NODE_ENV=development
SELF_CONTEXT_DB_PATH=./data/self-context.db
EMAIL_PROVIDER=gmail
EMAIL_SYNC_PAGE_SIZE=50

# Gmail OAuth (official Google OAuth flow)
# Option A: short-lived access token (for local testing)
GOOGLE_OAUTH_ACCESS_TOKEN=

# Option B: refresh-token flow (recommended)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
GOOGLE_EMAIL_ADDRESS=
